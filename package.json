{
  "name": "markedit-wikilinks",
  "version": "0.1.3",
  "description": "Obsidian-style [[wikilinks]] for MarkEdit.",
  "keywords": [
    "markedit",
    "markedit-extension",
    "wikilinks",
    "obsidian",
    "codemirror",
    "markdown"
  ],
  "author": "Georgios Giannoutsos Barkas <me@nuc.gr>",
  "license": "MIT",
  "homepage": "https://github.com/nuc/MarkEdit-wikilinks#readme",
  "bugs": {
    "url": "https://github.com/nuc/MarkEdit-wikilinks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuc/MarkEdit-wikilinks.git"
  },
  "scripts": {
    "build": "vite build",
    "reload": "osascript -e 'quit app \"MarkEdit\"' -e 'delay 1' -e 'launch app \"MarkEdit\"'",
    "uninstall": "rm ~/Library/Containers/app.cyan.markedit/Data/Documents/scripts/$(node -p \"require('./package.json').name\").js"
  },
  "devDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/markdown": "^1.0.0",
    "@types/node": "^22.0.0",
    "markedit-api": "https://github.com/MarkEdit-app/MarkEdit-api#v0.23.0",
    "markedit-vite": "https://github.com/MarkEdit-app/MarkEdit-vite#v0.5.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
